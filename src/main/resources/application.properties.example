# =============================================================
# Bennieslab Backend — Configuration Template
# Copy this file to application.properties and fill in real values,
# OR set these as environment variables on the deployment host (Render).
# application.properties is gitignored — NEVER commit secrets.
# =============================================================

# --- Database ---
# Production: MySQL (the app also ships H2 for local dev and a
# PostgreSQL driver if you prefer that)
spring.datasource.url=jdbc:mysql://localhost:3306/bennieslab
spring.datasource.username=your_db_username
spring.datasource.password=your_db_password
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.jpa.hibernate.ddl-auto=update
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# --- Admin bootstrap account (created on first startup) ---
admin.email=your_admin_email@example.com
admin.password=your_admin_password
admin.first-name=Benson
admin.last-name=Musonda

# --- Object storage (Backblaze B2, S3-compatible) ---
s3.endpoint-url=https://s3.us-east-005.backblazeb2.com
s3.bucket-name=your-bucket-name
aws.access-key-id=your_access_key_id
aws.secret-access-key=your_secret_access_key

# --- JWT ---
# Base64-encoded secret key (generate with: openssl rand -base64 64)
application.security.jwt.secret-key=your_base64_secret_key_here
# Token expiration in milliseconds (e.g. 1 day = 86400000)
application.security.jwt.expiration=86400000

# --- Optional: CORS for local dev (SecurityConfig handles production) ---
# (Not needed here; WebConfig allows http://localhost:5500 directly)